generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUM DEFINITIONS (INDONESIAN POS & MULTI-VERTICAL SAAS)
// ============================================================

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
  INVENTORY
  ACCOUNTANT
}

enum BusinessType {
  RETAIL
  FNB_CAFE
  FNB_RESTAURANT
  FNB_WARUNG
  SERVICE
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO_BUSINESS
  ENTERPRISE
}

enum ProductType {
  FINISHED_GOOD // Barang Jadi (Ritel langsung jual)
  RAW_MATERIAL  // Bahan Baku Mentah (Bahan resep F&B)
  MANUFACTURED  // Produk Jadi Ber-Resep / BOM (Dimsum, Kopi)
  SERVICE       // Jasa / Layanan non-fisik
}

enum StationType {
  KITCHEN
  BAR
  DESSERT
  GENERAL
}

enum TaxType {
  NONE
  PPN_11 // PPN 11%
  PPN_12 // PPN 12%
  PB1_10 // Pajak Restoran / Pajak Daerah 10%
  CUSTOM
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum KDSStatus {
  QUEUED
  COOKING
  READY
  SERVED
  CANCELED
}

enum PaymentType {
  CASH
  BANK_TRANSFER
  QRIS
  E_WALLET
}

enum AdjustmentReason {
  DAMAGED
  LOST
  EXPIRED
  STOCK_OPNAME
  OTHER
}

enum ActionType {
  // Sale actions
  SALE_CREATED
  SALE_VOIDED
  // Product actions
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  // Batch/Restock actions
  BATCH_CREATED
  // Stock actions
  STOCK_ADJUSTED
  // Table actions
  TABLE_CREATED
  TABLE_UPDATED
  TABLE_DELETED
  // Recipe & KDS
  RECIPE_UPDATED
  KDS_STATUS_CHANGED
  // User actions
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  // Finance actions
  FINANCE_ENTRY_CREATED
  FINANCE_ENTRY_UPDATED
  FINANCE_ENTRY_ARCHIVED
  FINANCE_CATEGORY_CREATED
  FINANCE_CATEGORY_UPDATED
  FINANCE_CATEGORY_DEACTIVATED
}

enum FinanceDirection {
  IN
  OUT
}

enum FinanceSource {
  MANUAL
  SALE
  SALE_VOID
  RESTOCK
}

enum BotBusinessDayMode {
  CLOSING_CUTOFF
}

enum BotJobType {
  TELEGRAM_MESSAGE
  DAILY_SUMMARY
}

enum BotJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================
// CORE ENTITIES
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  supervisorPin String?   // Hash 6-digit PIN untuk otorisasi instan supervisor di POS
  role          UserRole  @default(CASHIER)
  avatar        String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sales            Sale[]
  activityLogs     ActivityLog[]
  stockAdjustments StockAdjustment[]
  financeEntries   FinanceEntry[]

  @@map("users")
}

model Store {
  id                String           @id @default(cuid())
  name              String
  businessType      BusinessType     @default(FNB_CAFE)
  tier              SubscriptionTier @default(PRO_BUSINESS)
  address           String?
  phone             String?
  email             String?
  logo              String?
  taxType           TaxType          @default(PB1_10)
  taxRate           Decimal          @default(10) @db.Decimal(5, 2)
  taxInclusive      Boolean          @default(false)
  serviceChargeRate Decimal          @default(5) @db.Decimal(5, 2)
  enableRounding    Boolean          @default(true)
  defaultMarkup     Decimal          @default(30) @db.Decimal(5, 2)
  currency          String           @default("IDR")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("stores")
}

model BotSettings {
  id               String             @id @default(cuid())
  enabled          Boolean            @default(false)
  timezone         String             @default("Asia/Jakarta")
  closingTimeLocal String             @default("22:00")
  summaryEnabled   Boolean            @default(false)
  openaiModel      String             @default("gpt-5.5")
  openaiApiKeyEncrypted String?
  telegramBotTokenEncrypted String?
  businessDayMode  BotBusinessDayMode @default(CLOSING_CUTOFF)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("bot_settings")
}

model TelegramChatBinding {
  id                String   @id @default(cuid())
  telegramChatId    String   @unique
  chatType          String
  title             String?
  username          String?
  isAuthorized      Boolean  @default(false)
  canReceiveSummary Boolean  @default(false)
  lastSeenAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isAuthorized])
  @@index([canReceiveSummary])
  @@map("telegram_chat_bindings")
}

model BotJob {
  id           String       @id @default(cuid())
  type         BotJobType
  status       BotJobStatus @default(PENDING)
  payload      Json
  attemptCount Int          @default(0)
  nextRetryAt  DateTime     @default(now())
  lockedAt     DateTime?
  errorMessage String?
  dedupeKey    String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, nextRetryAt])
  @@index([type, status])
  @@index([lockedAt])
  @@map("bot_jobs")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  color       String?
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  products Product[]

  @@map("categories")
}

model Unit {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name])
  @@index([isActive])
  @@map("units")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  batches ProductBatch[]

  @@map("suppliers")
}

model Customer {
  id            String    @id @default(cuid())
  name          String
  phone         String?   @unique
  email         String?
  address       String?
  memberTier    String    @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  loyaltyPoints Int       @default(0)
  totalSpent    Decimal   @default(0) @db.Decimal(15, 2)
  visitCount    Int       @default(0)
  lastVisitAt   DateTime?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sales Sale[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Outlet {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique
  address           String?
  phone             String?
  isMain            Boolean  @default(false)
  taxType           TaxType  @default(PB1_10)
  taxRate           Decimal  @default(10) @db.Decimal(5, 2)
  serviceChargeRate Decimal  @default(5) @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("outlets")
}

model Product {
  id                String       @id @default(cuid())
  name              String
  sku               String       @unique
  barcode           String?      @unique
  description       String?
  productType       ProductType  @default(FINISHED_GOOD)
  station           StationType  @default(GENERAL)
  unit              String       @default("pcs")
  image             String?
  lowStockThreshold Int          @default(10)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  categoryId          String
  category            Category          @relation(fields: [categoryId], references: [id])
  batches             ProductBatch[]
  saleItems           SaleItem[]
  stockAdjustments    StockAdjustment[]
  recipesAsParent     RecipeItem[]      @relation("ParentRecipe")
  recipesAsIngredient RecipeItem[]      @relation("IngredientRecipe")

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model RecipeItem {
  id              String   @id @default(cuid())
  parentProductId String
  parentProduct   Product  @relation("ParentRecipe", fields: [parentProductId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Product  @relation("IngredientRecipe", fields: [ingredientId], references: [id], onDelete: Cascade)
  quantityNeeded  Decimal  @db.Decimal(12, 4)
  unit            String   @default("gram")
  wastagePercent  Decimal  @default(0) @db.Decimal(5, 2)
  createdAt       DateTime @default(now())

  @@unique([parentProductId, ingredientId])
  @@map("recipe_items")
}

// ============================================================
// BATCH-BASED INVENTORY (FIFO CORE)
// ============================================================

model ProductBatch {
  id           String    @id @default(cuid())
  batchNumber  String    @unique
  quantity     Int
  remainingQty Int
  costPrice    Decimal   @db.Decimal(15, 2)
  sellingPrice Decimal   @db.Decimal(15, 2)
  purchaseDate DateTime  @default(now())
  expiryDate   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  saleItemBatches SaleItemBatch[]
  financeEntries  FinanceEntry[]

  @@index([productId, remainingQty])
  @@index([productId, purchaseDate])
  @@map("product_batches")
}

// ============================================================
// MEJA RESTORAN & KAFE (TABLE MANAGEMENT)
// ============================================================

model RestaurantTable {
  id         String   @id @default(cuid())
  tableNo    String   @unique
  section    String   @default("Utama")
  capacity   Int      @default(4)
  qrToken    String   @unique @default(cuid())
  isOccupied Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales      Sale[]

  @@map("restaurant_tables")
}

// ============================================================
// SALES & TRANSACTIONS
// ============================================================

model Sale {
  id             String           @id @default(cuid())
  invoiceNumber  String           @unique
  orderType      OrderType        @default(DINE_IN)
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id])
  subtotal       Decimal          @db.Decimal(15, 2)
  discountAmount Decimal          @default(0) @db.Decimal(15, 2)
  serviceCharge  Decimal          @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal          @default(0) @db.Decimal(15, 2)
  roundingAmount Decimal          @default(0) @db.Decimal(8, 2)
  totalAmount    Decimal          @db.Decimal(15, 2)
  totalCost      Decimal          @db.Decimal(15, 2)
  grossProfit    Decimal          @db.Decimal(15, 2)
  paymentType    PaymentType
  paymentRef     String?
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  customerName   String?
  notes          String?
  isVoided       Boolean          @default(false)
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  cashierId      String
  cashier        User             @relation(fields: [cashierId], references: [id])
  items          SaleItem[]
  financeEntries FinanceEntry[]
  kdsOrders      KDSOrder[]

  @@index([cashierId])
  @@index([createdAt])
  @@index([invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id             String    @id @default(cuid())
  quantity       Int
  unitPrice      Decimal   @db.Decimal(15, 2)
  totalPrice     Decimal   @db.Decimal(15, 2)
  totalCost      Decimal   @db.Decimal(15, 2)
  discountAmount Decimal   @default(0) @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime  @default(now())

  // Relations
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  batchAllocations SaleItemBatch[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SaleItemBatch {
  id           String   @id @default(cuid())
  quantity     Int
  costPrice    Decimal  @db.Decimal(15, 2)
  sellingPrice Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now())

  // Relations
  saleItemId     String
  saleItem       SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  productBatchId String
  productBatch   ProductBatch @relation(fields: [productBatchId], references: [id])

  @@index([saleItemId])
  @@index([productBatchId])
  @@map("sale_item_batches")
}

// ============================================================
// KITCHEN DISPLAY SYSTEM (KDS)
// ============================================================

model KDSOrder {
  id        String      @id @default(cuid())
  saleId    String
  sale      Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  station   StationType @default(KITCHEN)
  status    KDSStatus   @default(QUEUED)
  itemsJson Json
  notes     String?
  tableNo   String?
  orderType OrderType   @default(DINE_IN)
  queuedAt  DateTime    @default(now())
  startedAt DateTime?
  readyAt   DateTime?
  servedAt  DateTime?

  @@index([station, status])
  @@map("kds_orders")
}

// ============================================================
// STOCK ADJUSTMENT
// ============================================================

model StockAdjustment {
  id             String           @id @default(cuid())
  quantityChange Int
  reason         AdjustmentReason
  notes          String?
  createdAt      DateTime         @default(now())

  // Relations
  productId String
  product   Product @relation(fields: [productId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@map("stock_adjustments")
}

// ============================================================
// AUDIT TRAIL
// ============================================================

model ActivityLog {
  id        String     @id @default(cuid())
  action    ActionType
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("activity_logs")
}

model FinanceCategory {
  id         String           @id @default(cuid())
  name       String
  direction  FinanceDirection
  isSystem   Boolean          @default(false)
  systemKey  String?          @unique
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  entries FinanceEntry[]

  @@unique([name, direction])
  @@index([direction, isActive])
  @@map("finance_categories")
}

model FinanceEntry {
  id              String           @id @default(cuid())
  amount          Decimal          @db.Decimal(15, 2)
  direction       FinanceDirection
  source          FinanceSource
  title           String
  notes           String?
  entryDate       DateTime
  isArchived      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  categoryId      String
  category        FinanceCategory  @relation(fields: [categoryId], references: [id])
  createdByUserId String?
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id])
  saleId          String?
  sale            Sale?            @relation(fields: [saleId], references: [id])
  productBatchId  String?
  productBatch    ProductBatch?    @relation(fields: [productBatchId], references: [id])

  @@index([entryDate])
  @@index([direction, entryDate])
  @@index([source, entryDate])
  @@index([categoryId, entryDate])
  @@index([createdByUserId])
  @@index([saleId])
  @@index([productBatchId])
  @@index([isArchived, entryDate])
  @@map("finance_entries")
}
