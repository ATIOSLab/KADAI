# ---------------------------------------------------------------------------
# KADAI Operating System - contoh environment produksi
# Salin menjadi .env lalu isi nilainya. JANGAN commit .env ke repository.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# Identitas aplikasi (WAJIB sama dengan hostname publik yang melayani Traefik,
# jika tidak: cookie sesi better-auth tidak akan terkirim saat login).
NEXT_PUBLIC_APP_NAME=KADAI
NEXT_PUBLIC_APP_URL=https://kadai.asia
APP_BASE_URL=https://kadai.asia
BETTER_AUTH_URL=https://kadai.asia
# Minimal 32 byte acak: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Database (PostgreSQL) - gunakan host internal jaringan dokploy-network.
DATABASE_URL=postgresql://user:password@host:5432/kadai
DB_WAIT_MAX_ATTEMPTS=30
DB_WAIT_DELAY_MS=2000

# ---- Seed & migrasi -------------------------------------------------------
# Semua seed default MATI. Demo hanya dijalankan di lingkungan demo, tidak
# pernah di produksi (seed demo membuat tenant/produk/user contoh + PIN).
RUN_SEED_ON_START=false
SEED_DEMO_ON_START=false

# ---- Akun admin awal ------------------------------------------------------
ADMIN_NAME=Admin KADAI
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Profil toko ----------------------------------------------------------
STORE_NAME=KADAI
STORE_ADDRESS=
STORE_PHONE=
STORE_EMAIL=

# ---- Cron & integrasi -----------------------------------------------------
# Wajib SAMA dengan header x-cron-secret pemanggil cron (mis. scripts/kadai_billing_cron.py).
CRON_SECRET=
# Kosong = tidak ada kode master demo yang berlaku.
DEMO_MASTER_CODES=
# Secret untuk POST /api/admin/seed-demo (header X-Seed-Key). Kosong = endpoint
# hanya bisa dipakai oleh sesi ADMIN yang login.
SEED_ADMIN_SECRET=

# ---- Telegram bot (opsional) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---- Pembayaran (opsional) -----------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
KADAI_BANK_NAME=
KADAI_BANK_ACCOUNT=
KADAI_BANK_HOLDER=

# ---- AI assistant (opsional) --------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
