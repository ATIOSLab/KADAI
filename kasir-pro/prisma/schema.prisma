generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUM DEFINITIONS (INDONESIAN POS & MULTI-VERTICAL SAAS)
// ============================================================

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
  INVENTORY
  ACCOUNTANT
}

enum BusinessType {
  RETAIL
  FNB_CAFE
  FNB_RESTAURANT
  FNB_WARUNG
  SERVICE
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO_BUSINESS
  ENTERPRISE
}

enum ProductType {
  FINISHED_GOOD // Barang Jadi (Ritel langsung jual)
  RAW_MATERIAL  // Bahan Baku Mentah (Bahan resep F&B)
  MANUFACTURED  // Produk Jadi Ber-Resep / BOM (Dimsum, Kopi)
  SERVICE       // Jasa / Layanan non-fisik
}

enum StationType {
  KITCHEN
  BAR
  DESSERT
  GENERAL
}

enum TaxType {
  NONE
  PPN_11 // PPN 11%
  PPN_12 // PPN 12%
  PB1_10 // Pajak Restoran / Pajak Daerah 10%
  CUSTOM
}

enum TaxStatus {
  NON_PKP // Pengusaha Non-PKP (Bebas PPN / Tanpa Pungutan Pajak)
  PKP     // Pengusaha Kena Pajak (Wajib Pungut Pajak / PPN)
}

enum LegalEntityType {
  PERORANGAN    // Usaha Perorangan / Toko Kelontong / Warung
  PT_PERORANGAN // Perseroan Perorangan (UMK - PP No. 8/2021)
  CV            // Commanditaire Vennootschap (Persekutuan Komanditer)
  PT            // Perseroan Terbatas
  UD            // Usaha Dagang
  KOPERASI      // Koperasi Indonesia
  FIRMA         // Firma
  YAYASAN       // Yayasan / Lembaga Non-Profit
  LAINNYA       // Bentuk Usaha Lainnya
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum KDSStatus {
  QUEUED
  COOKING
  READY
  SERVED
  CANCELED
}

enum PaymentType {
  CASH
  BANK_TRANSFER
  QRIS
  E_WALLET
}

enum LaundryServiceType {
  KILOAN
  SATUAN
}

enum LaundryStatus {
  RECEIVED
  WASHING
  DRYING
  IRONING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum JobPaymentStatus {
  UNPAID
  PARTIAL_DP
  PAID_FULL
}

enum AdjustmentReason {
  DAMAGED
  LOST
  EXPIRED
  STOCK_OPNAME
  OTHER
}

enum OutletType {
  CENTRAL_WAREHOUSE
  CENTRAL_KITCHEN
  RETAIL_BOOTH
  FULL_SERVICE_STORE
}

enum CostingMethod {
  FIFO
  FEFO
  AVERAGE
}

enum KitchenWorkflow {
  DIRECT_SERVE
  KITCHEN_DISPATCH
  HYBRID
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum ActionType {
  // Sale actions
  SALE_CREATED
  SALE_VOIDED
  // Product actions
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  // Batch/Restock actions
  BATCH_CREATED
  // Stock actions
  STOCK_ADJUSTED
  STOCK_TRANSFERRED
  BATCH_PRODUCED
  // Table actions
  TABLE_CREATED
  TABLE_UPDATED
  TABLE_DELETED
  // Laundry & Work Order actions
  LAUNDRY_JOB_CREATED
  LAUNDRY_STATUS_CHANGED
  LAUNDRY_PICKED_UP
  // Recipe & KDS
  RECIPE_UPDATED
  KDS_STATUS_CHANGED
  // User actions
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  // Finance actions
  FINANCE_ENTRY_CREATED
  FINANCE_ENTRY_UPDATED
  FINANCE_ENTRY_ARCHIVED
  FINANCE_CATEGORY_CREATED
  FINANCE_CATEGORY_UPDATED
  FINANCE_CATEGORY_DEACTIVATED
}

enum FinanceDirection {
  IN
  OUT
}

enum FinanceSource {
  MANUAL
  SALE
  SALE_VOID
  RESTOCK
}

enum BotBusinessDayMode {
  CLOSING_CUTOFF
}

enum BotJobType {
  TELEGRAM_MESSAGE
  DAILY_SUMMARY
}

enum BotJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================
// CORE ENTITIES
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  supervisorPin String?   // Hash 6-digit PIN untuk otorisasi instan supervisor di POS
  role          UserRole  @default(CASHIER)
  avatar        String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  outletId         String?
  outlet           Outlet?           @relation(fields: [outletId], references: [id])
  sales            Sale[]
  activityLogs     ActivityLog[]
  stockAdjustments StockAdjustment[]
  financeEntries   FinanceEntry[]
  laundryJobs      LaundryJobOrder[]

  @@map("users")
}

model Store {
  id                String           @id @default(cuid())
  name              String
  businessType      BusinessType     @default(FNB_CAFE)
  tier              SubscriptionTier @default(PRO_BUSINESS)
  costingMethod     CostingMethod    @default(FIFO)
  kitchenWorkflow   KitchenWorkflow  @default(KITCHEN_DISPATCH)
  address           String?
  phone             String?
  email             String?
  logo              String?
  
  // Status Perpajakan & Legalitas Badan Usaha RI
  taxStatus         TaxStatus        @default(NON_PKP)
  legalEntityType   LegalEntityType  @default(PERORANGAN)
  legalName         String?          // Nama resmi badan usaha terdaftar (PT / CV / Koperasi)
  nib               String?          // Nomor Induk Berusaha (13 digit OSS-RBA)
  npwp              String?          // NPWP Badan / Usaha (15 / 16 digit NIK-NPWP)
  ownerNik          String?          // NIK KTP Pemilik (16 digit) jika usaha perorangan

  taxType           TaxType          @default(NONE)
  taxRate           Decimal          @default(0) @db.Decimal(5, 2)
  taxInclusive      Boolean          @default(false)
  serviceChargeRate Decimal          @default(0) @db.Decimal(5, 2)
  enableRounding    Boolean          @default(true)
  defaultMarkup     Decimal          @default(30) @db.Decimal(5, 2)
  currency          String           @default("IDR")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  subscriptions     StoreSubscription[]
  invoices          PaymentInvoice[]

  @@map("stores")
}

model BotSettings {
  id               String             @id @default(cuid())
  enabled          Boolean            @default(false)
  timezone         String             @default("Asia/Jakarta")
  closingTimeLocal String             @default("22:00")
  summaryEnabled   Boolean            @default(false)
  openaiModel      String             @default("gpt-5.5")
  openaiApiKeyEncrypted String?
  telegramBotTokenEncrypted String?
  businessDayMode  BotBusinessDayMode @default(CLOSING_CUTOFF)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("bot_settings")
}

model TelegramChatBinding {
  id                String   @id @default(cuid())
  telegramChatId    String   @unique
  chatType          String
  title             String?
  username          String?
  isAuthorized      Boolean  @default(false)
  canReceiveSummary Boolean  @default(false)
  lastSeenAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isAuthorized])
  @@index([canReceiveSummary])
  @@map("telegram_chat_bindings")
}

model BotJob {
  id           String       @id @default(cuid())
  type         BotJobType
  status       BotJobStatus @default(PENDING)
  payload      Json
  attemptCount Int          @default(0)
  nextRetryAt  DateTime     @default(now())
  lockedAt     DateTime?
  errorMessage String?
  dedupeKey    String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, nextRetryAt])
  @@index([type, status])
  @@index([lockedAt])
  @@map("bot_jobs")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  color       String?
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  products Product[]

  @@map("categories")
}

model Unit {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name])
  @@index([isActive])
  @@map("units")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  batches ProductBatch[]

  @@map("suppliers")
}

model Customer {
  id            String    @id @default(cuid())
  name          String
  phone         String?   @unique
  email         String?
  address       String?
  memberTier    String    @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  loyaltyPoints Int       @default(0)
  totalSpent    Decimal   @default(0) @db.Decimal(15, 2)
  visitCount    Int       @default(0)
  lastVisitAt   DateTime?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sales       Sale[]
  laundryJobs LaundryJobOrder[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Outlet {
  id                String          @id @default(cuid())
  name              String
  code              String          @unique
  outletType        OutletType      @default(RETAIL_BOOTH)
  kitchenWorkflow   KitchenWorkflow @default(DIRECT_SERVE)
  costingMethod     CostingMethod   @default(FIFO)
  address           String?
  phone             String?
  isMain            Boolean         @default(false)
  taxType           TaxType         @default(PB1_10)
  taxRate           Decimal         @default(10) @db.Decimal(5, 2)
  serviceChargeRate Decimal         @default(5) @db.Decimal(5, 2)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  users             User[]
  batches           ProductBatch[]
  sales             Sale[]
  tables            RestaurantTable[]
  transfersSent     StockTransfer[]   @relation("SourceOutlet")
  transfersReceived StockTransfer[]   @relation("DestinationOutlet")
  laundryJobs       LaundryJobOrder[]

  @@map("outlets")
}

model Product {
  id                String       @id @default(cuid())
  name              String
  sku               String       @unique
  barcode           String?      @unique
  description       String?
  productType       ProductType  @default(FINISHED_GOOD)
  station           StationType  @default(GENERAL)
  unit              String       @default("pcs")
  image             String?
  lowStockThreshold Int          @default(10)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  categoryId          String
  category            Category            @relation(fields: [categoryId], references: [id])
  batches             ProductBatch[]
  saleItems           SaleItem[]
  stockAdjustments    StockAdjustment[]
  recipesAsParent     RecipeItem[]        @relation("ParentRecipe")
  recipesAsIngredient RecipeItem[]        @relation("IngredientRecipe")
  stockTransferItems  StockTransferItem[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model RecipeItem {
  id              String   @id @default(cuid())
  parentProductId String
  parentProduct   Product  @relation("ParentRecipe", fields: [parentProductId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Product  @relation("IngredientRecipe", fields: [ingredientId], references: [id], onDelete: Cascade)
  quantityNeeded  Decimal  @db.Decimal(12, 4)
  unit            String   @default("gram")
  wastagePercent  Decimal  @default(0) @db.Decimal(5, 2)
  createdAt       DateTime @default(now())

  @@unique([parentProductId, ingredientId])
  @@map("recipe_items")
}

// ============================================================
// BATCH-BASED INVENTORY (FIFO CORE)
// ============================================================

model ProductBatch {
  id           String    @id @default(cuid())
  batchNumber  String    @unique
  quantity     Int
  remainingQty Int
  costPrice    Decimal   @db.Decimal(15, 2)
  sellingPrice Decimal   @db.Decimal(15, 2)
  purchaseDate DateTime  @default(now())
  expiryDate   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  outletId        String?
  outlet          Outlet?        @relation(fields: [outletId], references: [id])
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  saleItemBatches SaleItemBatch[]
  financeEntries  FinanceEntry[]

  @@index([productId, remainingQty])
  @@index([productId, purchaseDate])
  @@index([outletId])
  @@map("product_batches")
}

// ============================================================
// MEJA RESTORAN & KAFE (TABLE MANAGEMENT)
// ============================================================

model RestaurantTable {
  id         String   @id @default(cuid())
  tableNo    String   @unique
  section    String   @default("Utama")
  capacity   Int      @default(4)
  qrToken    String   @unique @default(cuid())
  isOccupied Boolean  @default(false)
  outletId   String?
  outlet     Outlet?  @relation(fields: [outletId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales      Sale[]

  @@map("restaurant_tables")
}

// ============================================================
// SALES & TRANSACTIONS
// ============================================================

model Sale {
  id             String           @id @default(cuid())
  invoiceNumber  String           @unique
  orderType      OrderType        @default(DINE_IN)
  outletId       String?
  outlet         Outlet?          @relation(fields: [outletId], references: [id])
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id])
  subtotal       Decimal          @db.Decimal(15, 2)
  discountAmount Decimal          @default(0) @db.Decimal(15, 2)
  serviceCharge  Decimal          @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal          @default(0) @db.Decimal(15, 2)
  roundingAmount Decimal          @default(0) @db.Decimal(8, 2)
  totalAmount    Decimal          @db.Decimal(15, 2)
  totalCost      Decimal          @db.Decimal(15, 2)
  grossProfit    Decimal          @db.Decimal(15, 2)
  paymentType    PaymentType
  paymentRef     String?
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  customerName   String?
  notes          String?
  isVoided       Boolean          @default(false)
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  cashierId      String
  cashier        User             @relation(fields: [cashierId], references: [id])
  items          SaleItem[]
  financeEntries FinanceEntry[]
  kdsOrders      KDSOrder[]
  laundryJob     LaundryJobOrder?

  @@index([cashierId])
  @@index([outletId])
  @@index([createdAt])
  @@index([invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id             String    @id @default(cuid())
  quantity       Int
  unitPrice      Decimal   @db.Decimal(15, 2)
  totalPrice     Decimal   @db.Decimal(15, 2)
  totalCost      Decimal   @db.Decimal(15, 2)
  discountAmount Decimal   @default(0) @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime  @default(now())

  // Relations
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  batchAllocations SaleItemBatch[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SaleItemBatch {
  id           String   @id @default(cuid())
  quantity     Int
  costPrice    Decimal  @db.Decimal(15, 2)
  sellingPrice Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now())

  // Relations
  saleItemId     String
  saleItem       SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  productBatchId String
  productBatch   ProductBatch @relation(fields: [productBatchId], references: [id])

  @@index([saleItemId])
  @@index([productBatchId])
  @@map("sale_item_batches")
}

// ============================================================
// KITCHEN DISPLAY SYSTEM (KDS)
// ============================================================

model KDSOrder {
  id        String      @id @default(cuid())
  saleId    String
  sale      Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  station   StationType @default(KITCHEN)
  status    KDSStatus   @default(QUEUED)
  itemsJson Json
  notes     String?
  tableNo   String?
  orderType OrderType   @default(DINE_IN)
  queuedAt  DateTime    @default(now())
  startedAt DateTime?
  readyAt   DateTime?
  servedAt  DateTime?

  @@index([station, status])
  @@map("kds_orders")
}

// ============================================================
// LAUNDRY & SERVICE JOB ORDERS (ENTERPRISE WORK ORDER ENGINE)
// ============================================================

model LaundryJobOrder {
  id              String             @id @default(cuid())
  jobCode         String             @unique // Nomor Resi Pelacakan (e.g. LND-20261108-0042)
  trackingToken   String             @unique @default(cuid()) // Token aman untuk scan QR link /lacak/[token]
  serviceType     LaundryServiceType @default(KILOAN)
  status          LaundryStatus      @default(RECEIVED)
  paymentStatus   JobPaymentStatus   @default(UNPAID)

  // Rincian Bobot & Komponen Layanan
  weightKg        Decimal?           @db.Decimal(6, 2) // Berat timbangan desimal (e.g. 4.85 kg)
  itemCount       Int?               // Jumlah potong pakaian fisik
  fragrance       String?            // Pilihan aroma parfum (e.g. Lavender, Sakura, Akasia)
  rackLocation    String?            // Lokasi rak / keranjang siap ambil (e.g. Rak B-03)
  specialNotes    String?            // Catatan noda / instruksi khusus pelanggan

  // Estimasi & Log Pengerjaan
  estimatedDoneAt DateTime           // Target waktu siap ambil
  receivedAt      DateTime           @default(now())
  washedAt        DateTime?
  driedAt         DateTime?
  ironedAt        DateTime?
  readyAt         DateTime?
  pickedUpAt      DateTime?

  // Financial Breakdown (DP & Pelunasan)
  totalAmount     Decimal            @db.Decimal(15, 2)
  downPayment     Decimal            @default(0) @db.Decimal(15, 2)
  remainingAmount Decimal            @default(0) @db.Decimal(15, 2)
  pickupPaymentMethod PaymentType?   // Metode bayar pelunasan saat ambil barang
  pickupPaymentRef    String?

  // Notifikasi WhatsApp
  whatsappNotified Boolean           @default(false)
  notifiedAt       DateTime?

  // Relations
  saleId          String             @unique
  sale            Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  outletId        String?
  outlet          Outlet?            @relation(fields: [outletId], references: [id])
  customerId      String?
  customer        Customer?          @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String?
  handledById     String
  handledBy       User               @relation(fields: [handledById], references: [id])

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([customerPhone])
  @@index([jobCode])
  @@index([trackingToken])
  @@map("laundry_job_orders")
}

// ============================================================
// STOCK ADJUSTMENT
// ============================================================

model StockAdjustment {
  id             String           @id @default(cuid())
  quantityChange Int
  reason         AdjustmentReason
  notes          String?
  createdAt      DateTime         @default(now())

  // Relations
  productId String
  product   Product @relation(fields: [productId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@map("stock_adjustments")
}

// ============================================================
// AUDIT TRAIL
// ============================================================

model ActivityLog {
  id        String     @id @default(cuid())
  action    ActionType
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("activity_logs")
}

model FinanceCategory {
  id         String           @id @default(cuid())
  name       String
  direction  FinanceDirection
  isSystem   Boolean          @default(false)
  systemKey  String?          @unique
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  entries FinanceEntry[]

  @@unique([name, direction])
  @@index([direction, isActive])
  @@map("finance_categories")
}

model FinanceEntry {
  id              String           @id @default(cuid())
  amount          Decimal          @db.Decimal(15, 2)
  direction       FinanceDirection
  source          FinanceSource
  title           String
  notes           String?
  entryDate       DateTime
  isArchived      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  categoryId      String
  category        FinanceCategory  @relation(fields: [categoryId], references: [id])
  createdByUserId String?
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id])
  saleId          String?
  sale            Sale?            @relation(fields: [saleId], references: [id])
  productBatchId  String?
  productBatch    ProductBatch?    @relation(fields: [productBatchId], references: [id])

  @@index([entryDate])
  @@index([direction, entryDate])
  @@index([source, entryDate])
  @@index([categoryId, entryDate])
  @@index([createdByUserId])
  @@index([saleId])
  @@index([productBatchId])
  @@index([isArchived, entryDate])
  @@map("finance_entries")
}

// ============================================================
// MUTASI & TRANSFER STOK MULTI-CABANG (CENTRAL HUB & SPOKE)
// ============================================================

model StockTransfer {
  id                  String              @id @default(cuid())
  transferNumber      String              @unique
  sourceOutletId      String
  sourceOutlet        Outlet              @relation("SourceOutlet", fields: [sourceOutletId], references: [id])
  destinationOutletId String
  destinationOutlet   Outlet              @relation("DestinationOutlet", fields: [destinationOutletId], references: [id])
  status              TransferStatus      @default(IN_TRANSIT)
  notes               String?
  createdById         String?
  receivedById        String?
  shippedAt           DateTime?           @default(now())
  receivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  items               StockTransferItem[]

  @@index([sourceOutletId])
  @@index([destinationOutletId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  costPrice       Decimal       @default(0) @db.Decimal(15, 2)
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([stockTransferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

// ============================================================
// PERMOHONAN DEMO & PROSPEK SAAS (LEADS & GATED DEMO ACCESS)
// ============================================================

enum DemoRequestStatus {
  PENDING
  APPROVED
  CONTACTED
  REJECTED
}

model DemoRequest {
  id              String            @id @default(cuid())
  fullName        String
  businessName    String
  businessType    String
  phone           String
  email           String?
  outletCount     Int               @default(1)
  notes           String?
  accessCode      String            @unique
  referralCode    String?
  status          DemoRequestStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String?

  // Kepatuhan Pajak & Legalitas UMKM RI
  taxStatus       String?           // NON_PKP | PKP
  legalEntityType String?           // PERORANGAN | PT_PERORANGAN | CV | PT | UD | KOPERASI | dll
  legalName       String?
  nib             String?           // 13 digit OSS
  npwp            String?
  ownerNik        String?           // NIK KTP jika perorangan

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([phone])
  @@index([accessCode])
  @@index([referralCode])
  @@map("demo_requests")
}

// ============================================================
// PROGRAM MITRA REFERRAL & AFILIASI MARKETING KADAI
// ============================================================

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

enum ReferralLeadStatus {
  LEAD
  TRIAL
  SUBSCRIBED
  CHURNED
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

model ReferralPartner {
  id                String          @id @default(cuid())
  fullName          String
  phone             String
  email             String
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  referralCode      String          @unique
  commissionRate    Decimal         @default(20.00) @db.Decimal(5, 2)
  status            PartnerStatus   @default(ACTIVE)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  leads             ReferralLead[]
  payouts           ReferralPayout[]

  @@index([phone])
  @@index([referralCode])
  @@index([status])
  @@map("referral_partners")
}

model ReferralLead {
  id                 String             @id @default(cuid())
  partnerId          String
  partner            ReferralPartner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  leadName           String
  businessName       String
  phone              String
  packageTier        String?
  status             ReferralLeadStatus @default(LEAD)
  subscriptionAmount Decimal            @default(0) @db.Decimal(15, 2)
  commissionEarned   Decimal            @default(0) @db.Decimal(15, 2)
  commissionPaid     Decimal            @default(0) @db.Decimal(15, 2)
  linkedStoreId      String?

  // Kepatuhan Pajak & Legalitas UMKM RI
  taxStatus          String?
  legalEntityType    String?
  legalName          String?
  nib                String?
  npwp               String?
  ownerNik           String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  invoices           PaymentInvoice[]

  @@index([partnerId])
  @@index([phone])
  @@index([status])
  @@map("referral_leads")
}

model ReferralPayout {
  id           String          @id @default(cuid())
  partnerId    String
  partner      ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount       Decimal         @db.Decimal(15, 2)
  period       String?
  status       PayoutStatus    @default(PENDING)
  paymentProof String?
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([partnerId, period])
  @@index([partnerId])
  @@index([status])
  @@map("referral_payouts")
}

// ============================================================
// BILLING ENGINE: LANGGANAN & TAGIHAN RESMI KADAI
// Sumber komisi berulang program mitra referral.
// ============================================================

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PaymentProvider {
  MANUAL
  MIDTRANS
  XENDIT
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
  REFUNDED
}

model StoreSubscription {
  id        String             @id @default(cuid())
  storeId   String
  store     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tier      SubscriptionTier   @default(PRO_BUSINESS)
  cycle     BillingCycle       @default(MONTHLY)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  invoices  PaymentInvoice[]

  @@index([storeId])
  @@index([status])
  @@index([expiresAt])
  @@map("store_subscriptions")
}

model PaymentInvoice {
  id               String             @id @default(cuid())
  storeId          String
  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     StoreSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceNumber    String             @unique
  description      String
  tier             SubscriptionTier   @default(PRO_BUSINESS)
  cycle            BillingCycle       @default(MONTHLY)
  amount           Decimal            @db.Decimal(15, 2)
  provider         PaymentProvider    @default(MANUAL)
  providerRef      String?
  status           PaymentStatus      @default(PENDING)
  paidAt           DateTime?
  paidBy           String?
  paymentProof     String?
  notes            String?
  referralLeadId   String?
  referralLead     ReferralLead?      @relation(fields: [referralLeadId], references: [id], onDelete: SetNull)
  commissionEarned Decimal            @default(0) @db.Decimal(15, 2)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([referralLeadId])
  @@map("payment_invoices")
}

